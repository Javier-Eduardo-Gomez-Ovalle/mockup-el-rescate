      "$value": "0px 4px 16px rgba(23, 59, 99, 0.06), 0px 1px 4px rgba(23, 59, 99, 0.04)",
      "$type": "shadow"
    },
    "level-2-hover-3d": {
      "$value": "0px 12px 32px rgba(23, 59, 99, 0.10), 0px 4px 12px rgba(23, 59, 99, 0.05)",
      "$type": "shadow"
    },
    "level-3-floating": {
