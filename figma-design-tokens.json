{
  "$schema": "https://tr.designtokens.org/format/",
  "$metadata": {
    "project": "El Rescate — Rediseño Web (https://www.elrescate.org/)",
    "stage": "Etapa 1 — Design Foundations",
    "status": "PROVISIONAL — Pendiente de validación oficial por El Rescate",
    "figmaFileKey": "VGktR37ZboN18jlZNoftLu",
    "figmaFileUrl": "https://www.figma.com/design/VGktR37ZboN18jlZNoftLu"
  },
  "color": {
    "brand": {
      "primary-deep-blue": {
        "$value": "#173B63",
        "$type": "color",
        "$description": "[PROVISIONAL] Azul profundo principal. Autoridad institucional, textos primarios, encabezados y botones principales."
      },
      "secondary-blue": {
        "$value": "#245B87",
        "$type": "color",
        "$description": "[PROVISIONAL] Azul secundario. Estados interactivos (hover/active), enlaces editoriales y acentos de soporte."
      },
      "accent-amber": {
        "$value": "#E8A04A",
        "$type": "color",
        "$description": "[PROVISIONAL] Ámbar cálido. Llamados a la acción (CTA) de alto impacto, etiquetas editoriales y foco de accesibilidad."
      }
    },
    "surface": {
      "canvas-warm": {
        "$value": "#F7F6F2",
        "$type": "color",
        "$description": "[PROVISIONAL] Fondo cálido principal para evitar frialdad clínica y aportar cercanía humana."
      },
      "subtle-blue": {
        "$value": "#EAF1F6",
        "$type": "color",
        "$description": "[PROVISIONAL] Azul claro para bloques informativos secundarios, badges y contenedores de apoyo."
      },
      "elevated-white": {
        "$value": "#FFFFFF",
        "$type": "color",
        "$description": "[PROVISIONAL] Blanco puro para tarjetas elevadas (plano Z), navegación y campos de formulario."
      }
    },
    "semantic": {
      "text-primary": { "$value": "{color.brand.primary-deep-blue}", "$type": "color" },
      "text-secondary": { "$value": "#4A6583", "$type": "color" },
      "text-muted": { "$value": "#6E849B", "$type": "color" },
      "text-on-dark": { "$value": "{color.surface.elevated-white}", "$type": "color" },
      "border-subtle": { "$value": "#D8E4EE", "$type": "color" },
      "border-focus": { "$value": "{color.brand.secondary-blue}", "$type": "color" },
      "feedback-success": { "$value": "#2E7D5B", "$type": "color" },
      "feedback-warning": { "$value": "#D9822B", "$type": "color" },
      "feedback-error": { "$value": "#C93B3B", "$type": "color" }
    }
  },
  "typography": {
    "fontFamily": {
      "heading": {
        "$value": "Manrope",
        "$type": "fontFamily",
        "$description": "[PROVISIONAL] Tipografía display y de titulares con carácter editorial contemporáneo."
      },
      "body": {
        "$value": "Source Sans 3",
        "$type": "fontFamily",
        "$description": "[PROVISIONAL] Tipografía humanista de alta legibilidad para lectura extensa, formularios e interfaz."
      }
    },
